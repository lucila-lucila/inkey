# ---------------------------------------------------------------------------
# Inkey · variables de entorno
# Copiá este archivo como .env.local y completá los valores.
# Nada de esto se commitea: .env* está en .gitignore (salvo este ejemplo).
# ---------------------------------------------------------------------------

# --- Supabase --------------------------------------------------------------
# Panel de Supabase > Project Settings > API
# La URL y la anon key son públicas (viajan al navegador) y siempre pasan por RLS.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRETO. Saltea RLS: solo en el servidor, nunca con prefijo NEXT_PUBLIC_.
# Se usa para la lista de espera, el rate limiting y la bitácora.
SUPABASE_SERVICE_ROLE_KEY=

# --- Seguridad -------------------------------------------------------------
# SECRETO. Sal para hashear la IP en el rate limiting: así no guardamos IPs.
# Generala con: openssl rand -base64 32
RATE_LIMIT_SALT=

# SECRETO. Con esta clave se derivan los tokens de los links de perfil.
# Si la cambiás, los links ya compartidos dejan de funcionar.
# Generala con: openssl rand -base64 32
SHARE_LINK_SECRET=

# --- Sitio -----------------------------------------------------------------
# Se usa para armar los links de los mails (magic link, invitaciones).
# En local: http://localhost:3000 · En producción: https://tu-dominio
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Mails (Resend) --------------------------------------------------------
# SECRETO. Sin esta clave la app funciona igual, pero no sale ningún mail.
# La sacás de resend.com/api-keys
RESEND_API_KEY=

# De qué dirección salen los mails.
# Mientras no tengas dominio propio verificado, dejá el remitente de prueba de
# Resend: solo puede escribirle a la casilla con la que creaste la cuenta.
# Cuando verifiques el dominio: Inkey <hola@tudominio.com>
EMAIL_FROM=Inkey <onboarding@resend.dev>

# A dónde llegan las respuestas cuando alguien contesta un aviso. El remitente
# de arriba puede ser una casilla que nadie lee; esta tiene que ser una real.
# Ejemplo: contacto@tudominio.com
EMAIL_REPLY_TO=

# --- Cron ------------------------------------------------------------------
# SECRETO. Protege /api/cron/*: sin esto, cualquiera podría dispararlos.
# En Vercel se genera solo al agregar un cron; en local, cualquier cadena larga.
CRON_SECRET=
